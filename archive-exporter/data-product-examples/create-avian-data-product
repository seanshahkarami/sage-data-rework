#!/usr/bin/env -S duckdb -f

.timer on
.echo on

copy (
	select
		time,
		vsn,
		string_split(name, '.')[-1] as scientific_name,
		value_str::DOUBLE as confidence
	from 'archive/**/*.parquet'
	where plugin like 'registry.sagecontinuum.org/dariodematties/avian-diversity-monitoring:%' and name like 'env.detection.avian.%'
	order by vsn, time
) to 'avian.parquet' (
	format parquet,
	compression zstd,
	compression_level 9,
	PARQUET_VERSION V2
);
