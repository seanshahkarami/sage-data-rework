#!/usr/bin/env -S duckdb -f

.timer on
.echo on

select plugin, count(*) as count from 'archive/**/*.parquet' group by plugin order by count;

select string_split(plugin, '/')[-2] as creator, count(*) as count from 'archive/**/*.parquet' group by creator order by count;

select date, count(*) as count from 'archive/**/*.parquet' group by date order by date;

select count(*) as count from 'archive/**/*.parquet';
