#!/usr/bin/env duckdb -f

.echo on
.maxrows 10
.timer on

-- how many records do we have?
select count(*) as count from 'avian-detections.parquet';

-- show number of detections per node
select vsn, count(*) as count
from 'avian-detections.parquet'
where confidence > 0.5
group by vsn
order by count;

-- show top results by species
with counts as (
    select vsn, scientific_name, count(*) as count
    from 'avian-detections.parquet'
    where confidence > 0.5
    group by vsn, scientific_name
)
select c.vsn, c.scientific_name, l.common_name, c.count
from counts c
left join 'labels.csv' l using (scientific_name)
order by count, common_name;
